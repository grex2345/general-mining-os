{
  "manifest_version": 3,
  "name": "Arena PC Control — Secure Local MCP Bridge",
  "version": "0.1.0",
  "description": "Connects Arena.ai to your local Windows PC via an authenticated, permission-gated MCP bridge (files, browser, desktop apps, PowerShell, memory).",
  "permissions": ["storage"],
  "host_permissions": [
    "https://arena.ai/*",
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arena PC Control"
  },
  "content_scripts": [
    {
      "matches": ["https://arena.ai/*"],
      "js": ["protocol.js", "arena_adapter.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
