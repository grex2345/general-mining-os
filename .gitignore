# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# research: do not commit cloned third-party repositories (2.8 GB)
/research/clones/
# keep the evidence, not the massive trees
/research/raw/apiprobe/

# scratch workspace (clones, probes)
/.scratch/
studio/scratch/

# Round 5 speech stack: installed by studio/voice_setup.sh, not source
studio/lib/
studio/lib_piper/
studio/piper/

# Round 6 render frames: intermediates. The deliverables live in
# research/artifacts/round6/ and are regenerated by studio/scratch/r6*.mjs
/frames/

# Round 8: user reference videos are inputs (live in Google Drive), not repo assets
google_drive/

# Round 11 regenerable audio intermediates (keep the MP4 deliverable)
research/artifacts/round11/*.wav
