  "finalPerBeatA": [
    {
      "id": "b01",
      "emotion": "comedy",
      "text": "Everyone in the village laughed at Sami.",
      "dur": 2.84,
      "f0MedianHz": 118,
      "pitchRangeSt": 20.28,
      "pitchStdSt": 6.6,
      "gesturesPer10s": 21.13,
      "dynamicRangeDb": 34.9,
      "centroidHz": 717,
      "wordsPerSec": 3.11
    },
    {
      "id": "b02",
      "emotion": "warm",
      "text": "While the others chased gold, he chose clay.",
      "dur": 3.83,
      "f0MedianHz": 157,
      "pitchRangeSt": 20.89,
      "pitchStdSt": 6.33,
      "gesturesPer10s": 15.67,
      "dynamicRangeDb": 48.13,
      "centroidHz": 638,
      "wordsPerSec": 2.72
    },
    {
      "id": "b03",
      "emotion": "sadness",
      "text": "He shaped a thousand pots, and threw a thousand more away.",
      "dur": 5.04,
      "f0MedianHz": 145,
      "pitchRangeSt": 13.48,
      "pitchStdSt": 4.24,
      "gesturesPer10s": 19.84,
      "dynamicRangeDb": 34.64,
      "centroidHz": 406,
      "wordsPerSec": 2.97
    },
    {
      "id": "b04",
      "emotion": "tension",
      "text": "Then one night, he fired the kiln hotter than ever before.",
      "dur": 4.36,
      "f0MedianHz": 161,
      "pitchRangeSt": 19.18,
      "pitchStdSt": 6,
      "gesturesPer10s": 22.94,
      "dynamicRangeDb": 24.04,
      "centroidHz": 407,
      "wordsPerSec": 2.91
    },
    {
      "id": "b05",
      "emotion": "mystery",
      "text": "When the doors swung open, the whole village fell silent.",
      "dur": 4.38,
      "f0MedianHz": 130,
      "pitchRangeSt": 15.9,
      "pitchStdSt": 5.36,
      "gesturesPer10s": 15.98,
      "dynamicRangeDb": 42.42,
      "centroidHz": 645,
      "wordsPerSec": 3.13
    },
    {
      "id": "b06",
      "emotion": "reveal",
      "text": "Because what came out wasn't just pottery.",
      "dur": 2.81,
      "f0MedianHz": 153,
      "pitchRangeSt": 17.54,
      "pitchStdSt": 5.05,
      "gesturesPer10s": 21.35,
      "dynamicRangeDb": 39.46,
      "centroidHz": 599,
      "wordsPerSec": 3.35
    },
    {
      "id": "b07",
      "emotion": "resolve",
      "text": "And the boy they laughed at became the one they remembered.",
      "dur": 3.77,
      "f0MedianHz": 121,
      "pitchRangeSt": 16.11,
      "pitchStdSt": 4.9,
      "gesturesPer10s": 26.53,
      "dynamicRangeDb": 25.91,
      "centroidHz": 452,
      "wordsPerSec": 3.45
    }
  ],
