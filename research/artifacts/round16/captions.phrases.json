[
 {
  "text": "In Jujutsu Kaisen,",
  "t0": 0.7,
  "t1": 2.24,
  "words": 3
 },
 {
  "text": "Gojo's infinity isn't a shield;",
  "t0": 2.24,
  "t1": 4.56,
  "words": 5
 },
 {
  "text": "it's a coffin,",
  "t0": 4.56,
  "t1": 5.74,
  "words": 3
 },
 {
  "text": "and he's sealed inside it.",
  "t0": 5.74,
  "t1": 7.82,
  "words": 5
 },
 {
  "text": "Infinity stops anything from touching",
  "t0": 7.82,
  "t1": 9.62,
  "words": 5
 },
 {
  "text": "him, but if nothing gets",
  "t0": 9.62,
  "t1": 11.16,
  "words": 5
 },
 {
  "text": "in, nothing gets out.",
  "t0": 11.16,
  "t1": 13.44,
  "words": 4
 },
 {
  "text": "Infinity isn't a wall;",
  "t0": 13.44,
  "t1": 14.86,
  "words": 4
 },
 {
  "text": "it's a thermos.",
  "t0": 14.86,
  "t1": 16.26,
  "words": 3
 },
 {
  "text": "NASA spent millions solving this",
  "t0": 16.26,
  "t1": 18.08,
  "words": 5
 },
 {
  "text": "exact problem.",
  "t0": 18.08,
  "t1": 19.12,
  "words": 2
 },
 {
  "text": "And astronauts' suit is a",
  "t0": 19.12,
  "t1": 20.62,
  "words": 5
 },
 {
  "text": "perfect shield, and it still",
  "t0": 20.62,
  "t1": 22.42,
  "words": 5
 },
 {
  "text": "needs a radiator.",
  "t0": 22.42,
  "t1": 23.62,
  "words": 3
 },
 {
  "text": "You generate about 100 watts",
  "t0": 23.62,
  "t1": 25.62,
  "words": 5
 },
 {
  "text": "of heat doing nothing.",
  "t0": 25.62,
  "t1": 27.16,
  "words": 4
 },
 {
  "text": "A high-speed fight,",
  "t0": 27.16,
  "t1": 28.84,
  "words": 3
 },
 {
  "text": "roughly a thousand.",
  "t0": 28.84,
  "t1": 30.24,
  "words": 3
 },
 {
  "text": "Sweating can't save Gojo.",
  "t0": 30.26,
  "t1": 32.1,
  "words": 4
 },
 {
  "text": "The sweat can't evaporate.",
  "t0": 32.1,
  "t1": 33.82,
  "words": 4
 },
 {
  "text": "Roughly four minutes per degree,",
  "t0": 33.82,
  "t1": 36,
  "words": 5
 },
 {
  "text": "twenty minutes, and his brain",
  "t0": 36,
  "t1": 37.84,
  "words": 5
 },
 {
  "text": "starts cooking.",
  "t0": 37.84,
  "t1": 39,
  "words": 2
 },
 {
  "text": "He bakes inside his own",
  "t0": 39,
  "t1": 40.42,
  "words": 5
 },
 {
  "text": "defense.",
  "t0": 40.42,
  "t1": 41.16,
  "words": 1
 },
 {
  "text": "That's why the six eyes",
  "t0": 41.16,
  "t1": 42.68,
  "words": 5
 },
 {
  "text": "are mandatory.",
  "t0": 42.68,
  "t1": 43.8,
  "words": 2
 },
 {
  "text": "He isn't just blocking things;",
  "t0": 43.8,
  "t1": 45.68,
  "words": 5
 },
 {
  "text": "he manually filters every single",
  "t0": 45.68,
  "t1": 47.78,
  "words": 5
 },
 {
  "text": "atom:",
  "t0": 47.78,
  "t1": 48.54,
  "words": 1
 },
 {
  "text": "oxygen in, heat out,",
  "t0": 48.54,
  "t1": 50.22,
  "words": 4
 },
 {
  "text": "knives out.",
  "t0": 50.22,
  "t1": 51.16,
  "words": 2
 },
 {
  "text": "If he loses focus for",
  "t0": 51.16,
  "t1": 52.5,
  "words": 5
 },
 {
  "text": "one second, he cooks.",
  "t0": 52.5,
  "t1": 54.62,
  "words": 4
 },
 {
  "text": "He runs reverse curse technique",
  "t0": 54.62,
  "t1": 56.56,
  "words": 5
 },
 {
  "text": "24/7 just to heal the",
  "t0": 56.56,
  "t1": 58.72,
  "words": 5
 },
 {
  "text": "brain damage of doing thermal",
  "t0": 58.72,
  "t1": 60.46,
  "words": 5
 },
 {
  "text": "calculus.",
  "t0": 60.48,
  "t1": 61.48,
  "words": 1
 },
 {
  "text": "NASA built a radiator.",
  "t0": 61.48,
  "t1": 63.06,
  "words": 4
 },
 {
  "text": "Gojo built a brain that",
  "t0": 63.06,
  "t1": 64.38,
  "words": 5
 },
 {
  "text": "never switches off.",
  "t0": 64.38,
  "t1": 65.74,
  "words": 3
 },
 {
  "text": "That's the difference.",
  "t0": 65.74,
  "t1": 67.02,
  "words": 3
 },
 {
  "text": "One can be switched off",
  "t0": 67.02,
  "t1": 67.92,
  "words": 5
 },
 {
  "text": "for maintenance;",
  "t0": 67.92,
  "t1": 68.84,
  "words": 2
 },
 {
  "text": "the other can't.",
  "t0": 68.84,
  "t1": 70,
  "words": 3
 },
 {
  "text": "You've got your own infinity,",
  "t0": 70,
  "t1": 71.64,
  "words": 5
 },
 {
  "text": "a rule you never break,",
  "t0": 71.64,
  "t1": 73.34,
  "words": 5
 },
 {
  "text": "so nothing hurts you.",
  "t0": 73.34,
  "t1": 74.68,
  "words": 4
 },
 {
  "text": "The call you don't make,",
  "t0": 74.68,
  "t1": 76.26,
  "words": 5
 },
 {
  "text": "the thing you never try.",
  "t0": 76.26,
  "t1": 78.08,
  "words": 5
 },
 {
  "text": "Nothing gets in,",
  "t0": 78.08,
  "t1": 79.34,
  "words": 3
 },
 {
  "text": "nothing gets out.",
  "t0": 79.34,
  "t1": 80.68,
  "words": 3
 },
 {
  "text": "So what's yours?",
  "t0": 80.68,
  "t1": 81.31,
  "words": 3
 }
]